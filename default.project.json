{
  "name": "VFXPlayer",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Client": {
        "$path": "src/ReplicatedStorage/Client"
      },
      "Shared": {
        "$className": "Folder",
        "VFXPlayer": {
          "$path": "src/shared/VFXPlayer"
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    }
  }
}